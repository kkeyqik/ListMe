# =============================================================================
# ListMe environment variables (template)
# Copy to .env (and .env.local for Next.js-only overrides) and fill in values.
# Every value below is a placeholder. Never commit real values.
# Use a separate dev Supabase project locally, NOT production.
# =============================================================================

# --- Database (Prisma + pg) ---
# Pooled connection used by the app at runtime (Supabase transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session connection used by the Prisma CLI (port 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Storage bucket names (optional; code has defaults)
NEXT_PUBLIC_SUPABASE_LISTING_IMAGES_BUCKET=listing-images
NEXT_PUBLIC_SUPABASE_LISTING_VIDEOS_BUCKET=listing-videos
NEXT_PUBLIC_SUPABASE_LISTING_DOCUMENTS_BUCKET=listing-documents

# --- Firebase (phone OTP via Firebase Auth) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Optional server-side key for ID-token verification (falls back to NEXT_PUBLIC_FIREBASE_API_KEY)
# FIREBASE_API_KEY=your-firebase-web-api-key

# --- Session security ---
# REQUIRED in production: random 32+ char secret for signing session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# --- Site ---
# Public origin used for canonical URLs, sitemap and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# WhatsApp number, international digits without "+" (WhatsApp CTAs hidden when unset)
# NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
# Google Analytics measurement id (optional; can also be set in Admin > SEO)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Locality autocomplete (optional) ---
# Server-only Google Maps Platform key with "Places API (New)" enabled. When set,
# /api/places/autocomplete uses Google Places (restricted to India) and falls back
# to OpenStreetMap (Photon) on errors; when unset, Photon is used. Never prefix
# with NEXT_PUBLIC_. Restrict the key to the Places API (New) in Google Cloud.
# GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# --- Email (Nodemailer SMTP) ---
# When host/user/password are missing, email is simulated (not sent).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
# SMTP_PASS is accepted as a legacy alias for SMTP_PASSWORD.
SMTP_FROM="ListMe <no-reply@your-domain.example>"
# Where contact-form messages are delivered (CONTACT_EMAIL first, then ADMIN_EMAIL)
CONTACT_EMAIL=contact@your-domain.example
ADMIN_EMAIL=admin@your-domain.example

# --- Debug ---
# Set to "true" to log database pool metrics
# DEBUG_DB=true

# =============================================================================
# DEV-ONLY FLAGS. NEVER SET THESE IN PRODUCTION / VERCEL.
# =============================================================================
# ENABLE_MOCK_AUTH=true
# NEXT_PUBLIC_ENABLE_MOCK_AUTH=true
# MOCK_ADMIN_ID=00000000-0000-0000-0000-000000000000
